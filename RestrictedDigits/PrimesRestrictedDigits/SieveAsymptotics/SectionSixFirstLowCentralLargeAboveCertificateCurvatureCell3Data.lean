theorem cell3QDerivCoeff_natDegree (i : Nat) : (cell3QDerivCoeff i).natDegree ≤ 3 := by rw [← cell3QFull_deriv_coeff]; exact (cell3InnerDegreeLe_derivative cell3QFull_innerDegree) i

theorem cell3_one_sub_pow_coeff {R : Type*} [CommRing R] (a b : Nat) :
    ((1 - X : Polynomial R) ^ a).coeff b =
      (-1 : R) ^ a * ((-1 : R) ^ (a - b) * (a.choose b : R)) := by
  have hsub : (1 - X : Polynomial R) = -(X + C (-1 : R)) := by
    simp [sub_eq_add_neg]
  have hnegpow : ((-1 : Polynomial R) ^ a) = C ((-1 : R) ^ a) := by
    rw [show (-1 : Polynomial R) = C (-1 : R) by simp, ← Polynomial.C_pow]
  have hneg : (-(X + C (-1 : R)) : Polynomial R) ^ a =
      C ((-1 : R) ^ a) * (X + C (-1 : R)) ^ a := by
    rw [neg_pow, hnegpow]
  rw [hsub, hneg, Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow]
theorem cell3_bernstein_coeff_formula {R : Type*} [CommRing R]
    (n i k : Nat) :
    (bernsteinPolynomial R n i).coeff k = if i ≤ k then
      (n.choose i : R) * ((-1 : R) ^ (n - i) *
        ((-1 : R) ^ ((n - i) - (k - i)) * ((n - i).choose (k - i) : R)))
      else 0 := by
  rw [bernsteinPolynomial, ← Polynomial.C_eq_natCast, mul_assoc,
    Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul', cell3_one_sub_pow_coeff]
  split_ifs <;> simp_all
theorem cell3_bernstein_outer_coeff (n i k : Nat) :
    (bernsteinPolynomial (Polynomial Rat) n i).coeff k =
      C ((bernsteinPolynomial Rat n i).coeff k) := by
  simpa only [Polynomial.coeff_map] using
    (congrArg (fun p : Polynomial (Polynomial Rat) => p.coeff k)
      (bernsteinPolynomial.map (C : Rat →+* Polynomial Rat) n i)).symm
theorem cell3_tensor_coeff_formula
    (n m : Nat) (a : Nat → Nat → Rat) (k l : Nat) :
    ((tensorBernsteinPolynomial n m a).coeff k).coeff l =
      ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.range (m + 1),
        a i j * (bernsteinPolynomial Rat n i).coeff l *
          (bernsteinPolynomial Rat m j).coeff k := by
  rw [tensorBernsteinPolynomial]
  simp_rw [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul,
    cell3_bernstein_outer_coeff, Polynomial.coeff_mul_C, Polynomial.coeff_C_mul]

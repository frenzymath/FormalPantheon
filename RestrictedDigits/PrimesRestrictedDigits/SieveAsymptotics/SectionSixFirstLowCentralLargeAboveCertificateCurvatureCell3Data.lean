theorem cell3QDeriv2Coeff_coeff (i l : Nat) : (cell3QDeriv2Coeff i).coeff l = (cell3QDerivCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell3QDeriv2Coeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
theorem cell3OuterConst_coeff (a : Rat) (i l : Nat) : (cell3OuterConst a i).coeff l = if i = 0 then (if l = 0 then a else 0) else 0 := by by_cases hi : i = 0 <;> by_cases hl : l = 0 <;> simp [cell3OuterConst, Polynomial.coeff_C, hi, hl]
def cell3TwoPdCoeff (i : Nat) : Polynomial Rat := C 2 * cell3PDerivCoeff i def cell3TwoPCoeff (i : Nat) : Polynomial Rat := C 2 * cell3PCoeff i
theorem cell3TwoPdCoeff_coeff (i l : Nat) : (cell3TwoPdCoeff i).coeff l = 2 * (cell3PDerivCoeff i).coeff l := by simp [cell3TwoPdCoeff, Polynomial.coeff_C_mul]
theorem cell3TwoPCoeff_coeff (i l : Nat) : (cell3TwoPCoeff i).coeff l = 2 * (cell3PCoeff i).coeff l := by simp [cell3TwoPCoeff, Polynomial.coeff_C_mul]
def cell3SignedOuterRaw (k : Nat) : Polynomial Rat := -(cell3OuterConv cell3PDeriv2Coeff (fun j => cell3OuterConv cell3QCoeff cell3QCoeff j) k - cell3OuterConv (fun j => cell3OuterConv (fun h => cell3OuterConv (cell3OuterConst 2) cell3PDerivCoeff h) cell3QCoeff j) cell3QDerivCoeff k + cell3OuterConv (fun j => cell3OuterConv (cell3OuterConst 2) cell3PCoeff j) (fun j => cell3OuterConv cell3QDerivCoeff cell3QDerivCoeff j) k - cell3OuterConv (fun j => cell3OuterConv cell3PCoeff cell3QCoeff j) cell3QDeriv2Coeff k)
theorem cell3SignedCurvature_coeff_raw (k : Nat) : cell3SignedCurvature.coeff k = cell3SignedOuterRaw k := by rw [cell3SignedCurvature, cell3RationalPolynomials, cell3Constant, Polynomial.coeff_C_mul]; simp only [cell3SignedOuterRaw, Polynomial.coeff_sub, Polynomial.coeff_add, cell3_coeff_mul_outer, pow_two, cell3PFull_coeff, cell3QFull_coeff, cell3PFull_deriv_coeff, cell3QFull_deriv_coeff, cell3PFull_deriv2_coeff, cell3QFull_deriv2_coeff, cell3Constant_outer_coeff, Polynomial.C_neg, Polynomial.C_1, neg_mul, one_mul]
theorem cell3TwoPd_outer_eq (i : Nat) : cell3OuterConv (cell3OuterConst 2) cell3PDerivCoeff i = cell3TwoPdCoeff i := by have h := cell3_coeff_mul_outer (cell3Constant 2) cell3PFull.derivative i; simp_rw [cell3Constant_outer_coeff, cell3PFull_deriv_coeff] at h; rw [cell3Constant, Polynomial.coeff_C_mul, cell3PFull_deriv_coeff] at h; simpa only [cell3TwoPdCoeff] using h.symm
theorem cell3TwoP_outer_eq (i : Nat) : cell3OuterConv (cell3OuterConst 2) cell3PCoeff i = cell3TwoPCoeff i := by have h := cell3_coeff_mul_outer (cell3Constant 2) cell3PFull i; simp_rw [cell3Constant_outer_coeff, cell3PFull_coeff] at h; rw [cell3Constant, Polynomial.coeff_C_mul, cell3PFull_coeff] at h; simpa only [cell3TwoPCoeff] using h.symm
def cell3StageProductRow (s k : Nat) : Polynomial Rat := match s with | 0 => cell3OuterConv cell3QCoeff cell3QCoeff k | 1 => cell3OuterConv cell3TwoPdCoeff cell3QCoeff k | 2 => cell3OuterConv cell3QDerivCoeff cell3QDerivCoeff k | 3 => cell3OuterConv cell3PCoeff cell3QCoeff k | _ => 0
def cell3SignedOuterRow (k : Nat) : Polynomial Rat := -(cell3OuterConv cell3PDeriv2Coeff (cell3StageProductRow 0) k - cell3OuterConv (cell3StageProductRow 1) cell3QDerivCoeff k + cell3OuterConv cell3TwoPCoeff (cell3StageProductRow 2) k - cell3OuterConv (cell3StageProductRow 3) cell3QDeriv2Coeff k)
theorem cell3SignedOuterRaw_eq (k : Nat) : cell3SignedOuterRaw k = cell3SignedOuterRow k := by have hpd : (fun i : Nat => cell3OuterConv (cell3OuterConst 2) cell3PDerivCoeff i) = cell3TwoPdCoeff := funext cell3TwoPd_outer_eq; have hp : (fun i : Nat => cell3OuterConv (cell3OuterConst 2) cell3PCoeff i) = cell3TwoPCoeff := funext cell3TwoP_outer_eq; have h0 : cell3StageProductRow 0 = (fun j : Nat => cell3OuterConv cell3QCoeff cell3QCoeff j) := (by funext j; rfl); have h1 : cell3StageProductRow 1 = (fun j : Nat => cell3OuterConv cell3TwoPdCoeff cell3QCoeff j) := (by funext j; rfl); have h2 : cell3StageProductRow 2 = (fun j : Nat => cell3OuterConv cell3QDerivCoeff cell3QDerivCoeff j) := (by funext j; rfl); have h3 : cell3StageProductRow 3 = (fun j : Nat => cell3OuterConv cell3PCoeff cell3QCoeff j) := (by funext j; rfl); unfold cell3SignedOuterRaw cell3SignedOuterRow; rw [hpd, hp, h0, h1, h2, h3]

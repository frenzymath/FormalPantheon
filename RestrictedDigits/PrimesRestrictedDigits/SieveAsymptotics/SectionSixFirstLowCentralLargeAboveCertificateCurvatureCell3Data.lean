def cell3PowerCoeff (i j : Nat) : Rat :=
  cell3PowerScale * (cell3PowerNumerator i j : Rat)
def cell3PowerRow (i : Nat) : Polynomial Rat :=
  ∑ j ∈ Finset.range 10, C (cell3PowerCoeff i j) * X ^ j
noncomputable def cell3Power : BivariateRat :=
  ∑ i ∈ Finset.range 25, C (cell3PowerRow i) * X ^ i
theorem cell3BernsteinPolynomial_natDegree_le (R : Type*) [CommRing R] {n i : Nat} (hi : i ≤ n) : (bernsteinPolynomial R n i).natDegree ≤ n := by rw [bernsteinPolynomial]; have hc : ((Nat.choose n i : Polynomial R)).natDegree ≤ 0 := (by simp); have hx : (X ^ i : Polynomial R).natDegree ≤ i := Polynomial.natDegree_X_pow_le i; have hs : (1 - X : Polynomial R).natDegree ≤ 1 := Polynomial.natDegree_sub_le_of_le (m := 1) (n := 1) (by simp) (Polynomial.natDegree_X_le (R := R)); have h := Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le hc hx) (Polynomial.natDegree_pow_le_of_le (n - i) hs); simpa only [zero_add, mul_one, Nat.add_sub_of_le hi] using h
theorem cell3FinitePolynomial_coeff {R : Type*} [Semiring R] (n l : Nat) (a : Nat → R) : (∑ j ∈ Finset.range n, Polynomial.C (a j) * Polynomial.X ^ j).coeff l = if l < n then a l else 0 := by
  rw [Polynomial.finsetSum_coeff]; simp_rw [Polynomial.coeff_C_mul_X_pow]; by_cases hl : l < n
  · rw [if_pos hl, Finset.sum_eq_single l]
    · simp
    · intro b hb hbl; simp [Ne.symm hbl]
    · exact fun hnot => (hnot (Finset.mem_range.mpr hl)).elim
  · rw [if_neg hl]; apply Finset.sum_eq_zero; intro b hb
    have hlb : l ≠ b := by rintro rfl; exact hl (Finset.mem_range.mp hb)
    simp [hlb]
theorem cell3Power_outer_coeff (k : Nat) (hk : k < 25) : cell3Power.coeff k = cell3PowerRow k := by simpa only [cell3Power, if_pos hk] using cell3FinitePolynomial_coeff 25 k cell3PowerRow
theorem cell3Power_row_coeff (i l : Nat) : (cell3PowerRow i).coeff l = if l < 10 then cell3PowerCoeff i l else 0 := by simpa only [cell3PowerRow] using cell3FinitePolynomial_coeff 10 l (cell3PowerCoeff i)
theorem cell3PowerRow_natDegree (i : Nat) : (cell3PowerRow i).natDegree ≤ 9 := by rw [cell3PowerRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))
theorem cell3Tensor_coeff_zero (k l : Nat) (hl : 10 ≤ l) : (cell3Tensor.coeff k).coeff l = 0 := by rw [cell3Tensor, cell3_tensor_coeff_formula]; apply Finset.sum_eq_zero; intro i hi; apply Finset.sum_eq_zero; intro j hj; rw [Polynomial.coeff_eq_zero_of_natDegree_lt ((cell3BernsteinPolynomial_natDegree_le Rat (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))).trans_lt (Nat.lt_of_succ_le hl))]; ring
theorem cell3Tensor_natDegree : cell3Tensor.natDegree ≤ 24 := by rw [cell3Tensor, tensorBernsteinPolynomial]; apply Polynomial.natDegree_sum_le_of_forall_le; intro i hi; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := 24) (Polynomial.natDegree_C _).le (cell3BernsteinPolynomial_natDegree_le (Polynomial Rat) (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))).trans (by simp)
theorem cell3PFull_natDegree : cell3PFull.natDegree ≤ 8 := by rw [cell3PFull]; apply Polynomial.natDegree_sum_le_of_forall_le; intro i hi; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := i) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le i)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)))
theorem cell3QFull_natDegree : cell3QFull.natDegree ≤ 9 := by rw [cell3QFull]; apply Polynomial.natDegree_sum_le_of_forall_le; intro i hi; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := i) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le i)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)))
theorem cell3SignedCurvature_natDegree : cell3SignedCurvature.natDegree ≤ 24 := by let p := cell3RationalPolynomials.1; let q := cell3RationalPolynomials.2; have hc (a : Rat) : (cell3Constant a).natDegree ≤ 0 := (by simp [cell3Constant]); have hp : p.natDegree ≤ 8 := (by simpa [p, cell3RationalPolynomials] using cell3PFull_natDegree); have hq : q.natDegree ≤ 9 := (by simpa [q, cell3RationalPolynomials] using cell3QFull_natDegree); have hp1 : p.derivative.natDegree ≤ 7 := (Polynomial.natDegree_derivative_le p).trans (by simpa using Nat.sub_le_sub_right hp 1); have hp2 : p.derivative.derivative.natDegree ≤ 6 := (Polynomial.natDegree_derivative_le p.derivative).trans (by simpa using Nat.sub_le_sub_right hp1 1); have hq1 : q.derivative.natDegree ≤ 8 := (Polynomial.natDegree_derivative_le q).trans (by simpa using Nat.sub_le_sub_right hq 1); have hq2 : q.derivative.derivative.natDegree ≤ 7 := (Polynomial.natDegree_derivative_le q.derivative).trans (by simpa using Nat.sub_le_sub_right hq1 1); have h1 : (p.derivative.derivative * q ^ 2).natDegree ≤ 24 := (Polynomial.natDegree_mul_le_of_le hp2 (Polynomial.natDegree_pow_le_of_le 2 hq)).trans (by norm_num); have h2 : (cell3Constant 2 * p.derivative * q * q.derivative).natDegree ≤ 24 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc 2) hp1) hq) hq1).trans (by norm_num); have h3 : (cell3Constant 2 * p * q.derivative ^ 2).natDegree ≤ 24 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc 2) hp) (Polynomial.natDegree_pow_le_of_le 2 hq1)).trans (by norm_num); have h4 : (p * q * q.derivative.derivative).natDegree ≤ 24 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le hp hq) hq2).trans (by norm_num); have h12 := Polynomial.natDegree_sub_le_of_le (m := 24) (n := 24) h1 h2; have h123 := Polynomial.natDegree_add_le_of_degree_le h12 h3; have hraw := Polynomial.natDegree_sub_le_of_le (m := 24) (n := 24) h123 h4; change (cell3Constant (-1) * (p.derivative.derivative * q ^ 2 - cell3Constant 2 * p.derivative * q * q.derivative + cell3Constant 2 * p * q.derivative ^ 2 - p * q * q.derivative.derivative)).natDegree ≤ 24; exact (Polynomial.natDegree_mul_le_of_le (hc (-1)) hraw).trans (by norm_num)
def cell3PCoeff (i : Nat) : Polynomial Rat := if i < 9 then cell3PRow i else 0
def cell3QCoeff (i : Nat) : Polynomial Rat := if i < 10 then cell3QRow i else 0
theorem cell3PRow_coeff (i l : Nat) : (cell3PRow i).coeff l = if l < 4 then cell3PScale * (cell3PNumerator i l : Rat) else 0 := by simpa only [cell3PRow] using cell3FinitePolynomial_coeff 4 l (fun j => cell3PScale * (cell3PNumerator i j : Rat))
theorem cell3QRow_coeff (i l : Nat) : (cell3QRow i).coeff l = if l < 4 then cell3QScale * (cell3QNumerator i l : Rat) else 0 := by simpa only [cell3QRow] using cell3FinitePolynomial_coeff 4 l (fun j => cell3QScale * (cell3QNumerator i j : Rat))
theorem cell3PFull_coeff (i : Nat) : cell3PFull.coeff i = cell3PCoeff i := by simpa only [cell3PFull, cell3PCoeff] using cell3FinitePolynomial_coeff 9 i cell3PRow
theorem cell3QFull_coeff (i : Nat) : cell3QFull.coeff i = cell3QCoeff i := by simpa only [cell3QFull, cell3QCoeff] using cell3FinitePolynomial_coeff 10 i cell3QRow
theorem cell3PCoeff_coeff (i l : Nat) : (cell3PCoeff i).coeff l = if i < 9 then (if l < 4 then cell3PScale * (cell3PNumerator i l : Rat) else 0) else 0 := by by_cases hi : i < 9 <;> simp [cell3PCoeff, hi, cell3PRow_coeff]
theorem cell3QCoeff_coeff (i l : Nat) : (cell3QCoeff i).coeff l = if i < 10 then (if l < 4 then cell3QScale * (cell3QNumerator i l : Rat) else 0) else 0 := by by_cases hi : i < 10 <;> simp [cell3QCoeff, hi, cell3QRow_coeff]
def cell3OuterConst (a : Rat) (i : Nat) : Polynomial Rat := if i = 0 then C a else 0
def cell3OuterConv (p q : Nat → Polynomial Rat) (k : Nat) : Polynomial Rat := ∑ a ∈ Finset.antidiagonal k, p a.1 * q a.2
theorem cell3_coeff_mul_outer (p q : BivariateRat) (k : Nat) : (p * q).coeff k = cell3OuterConv (fun i => p.coeff i) (fun i => q.coeff i) k := by simp only [cell3OuterConv, Polynomial.coeff_mul]
def cell3ScalarConv (p q : Nat → Nat → Rat) (k l : Nat) : Rat := ∑ a ∈ Finset.antidiagonal k, ∑ b ∈ Finset.antidiagonal l, p a.1 b.1 * q a.2 b.2
theorem cell3OuterConv_coeff (p q : Nat → Polynomial Rat) (k l : Nat) : (cell3OuterConv p q k).coeff l = cell3ScalarConv (fun i j => (p i).coeff j) (fun i j => (q i).coeff j) k l := by rw [cell3OuterConv, cell3ScalarConv, Polynomial.finsetSum_coeff]; simp_rw [Polynomial.coeff_mul]
def cell3PDerivCoeff (i : Nat) : Polynomial Rat := cell3PCoeff (i + 1) * (i + 1 : Nat)
def cell3QDerivCoeff (i : Nat) : Polynomial Rat := cell3QCoeff (i + 1) * (i + 1 : Nat)
def cell3PDeriv2Coeff (i : Nat) : Polynomial Rat := cell3PDerivCoeff (i + 1) * (i + 1 : Nat)
def cell3QDeriv2Coeff (i : Nat) : Polynomial Rat := cell3QDerivCoeff (i + 1) * (i + 1 : Nat)
theorem cell3Constant_outer_coeff (a : Rat) (i : Nat) : (cell3Constant a).coeff i = cell3OuterConst a i := by by_cases hi : i = 0 <;> simp [cell3Constant, cell3OuterConst, hi, Polynomial.coeff_C_of_ne_zero]
theorem cell3PFull_deriv_coeff (i : Nat) : cell3PFull.derivative.coeff i = cell3PDerivCoeff i := by simp [cell3PDerivCoeff, Polynomial.coeff_derivative, cell3PFull_coeff]
theorem cell3QFull_deriv_coeff (i : Nat) : cell3QFull.derivative.coeff i = cell3QDerivCoeff i := by simp [cell3QDerivCoeff, Polynomial.coeff_derivative, cell3QFull_coeff]
theorem cell3PFull_deriv2_coeff (i : Nat) : cell3PFull.derivative.derivative.coeff i = cell3PDeriv2Coeff i := by simp only [Polynomial.coeff_derivative, cell3PDeriv2Coeff, cell3PDerivCoeff, cell3PFull_coeff]; push_cast; ring
theorem cell3QFull_deriv2_coeff (i : Nat) : cell3QFull.derivative.derivative.coeff i = cell3QDeriv2Coeff i := by simp only [Polynomial.coeff_derivative, cell3QDeriv2Coeff, cell3QDerivCoeff, cell3QFull_coeff]; push_cast; ring
theorem cell3PDerivCoeff_coeff (i l : Nat) : (cell3PDerivCoeff i).coeff l = (cell3PCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell3PDerivCoeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
theorem cell3QDerivCoeff_coeff (i l : Nat) : (cell3QDerivCoeff i).coeff l = (cell3QCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell3QDerivCoeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]

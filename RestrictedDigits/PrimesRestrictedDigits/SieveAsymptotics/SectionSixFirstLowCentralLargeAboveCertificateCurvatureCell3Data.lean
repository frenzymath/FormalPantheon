def cell3InnerDegreeLe (n : Nat) (p : BivariateRat) : Prop := ∀ i, (p.coeff i).natDegree ≤ n
theorem cell3InnerDegreeLe_add {n : Nat} {p q : BivariateRat} (hp : cell3InnerDegreeLe n p) (hq : cell3InnerDegreeLe n q) : cell3InnerDegreeLe n (p + q) := by intro i; rw [Polynomial.coeff_add]; exact Polynomial.natDegree_add_le_of_degree_le (hp i) (hq i)
theorem cell3InnerDegreeLe_sub {n : Nat} {p q : BivariateRat} (hp : cell3InnerDegreeLe n p) (hq : cell3InnerDegreeLe n q) : cell3InnerDegreeLe n (p - q) := by intro i; rw [Polynomial.coeff_sub]; simpa using Polynomial.natDegree_sub_le_of_le (m := n) (n := n) (hp i) (hq i)
theorem cell3InnerDegreeLe_mul {m n : Nat} {p q : BivariateRat} (hp : cell3InnerDegreeLe m p) (hq : cell3InnerDegreeLe n q) : cell3InnerDegreeLe (m + n) (p * q) := by intro i; rw [Polynomial.coeff_mul]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact Polynomial.natDegree_mul_le_of_le (hp j.1) (hq j.2)
theorem cell3InnerDegreeLe_derivative {n : Nat} {p : BivariateRat} (hp : cell3InnerDegreeLe n p) : cell3InnerDegreeLe n p.derivative := by intro i; rw [Polynomial.coeff_derivative]; have hs : (C ((i + 1 : Nat) : Rat)).natDegree ≤ 0 := (Polynomial.natDegree_C _).le; simpa using Polynomial.natDegree_mul_le_of_le (hp (i + 1)) hs
theorem cell3PRow_natDegree (i : Nat) : (cell3PRow i).natDegree ≤ 3 := by rw [cell3PRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))
theorem cell3QRow_natDegree (i : Nat) : (cell3QRow i).natDegree ≤ 3 := by rw [cell3QRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))

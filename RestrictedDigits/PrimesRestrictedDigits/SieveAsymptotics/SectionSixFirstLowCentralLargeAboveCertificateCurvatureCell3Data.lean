theorem cell3QFull_innerDegree : cell3InnerDegreeLe 3 cell3QFull := by intro i; rw [cell3QFull_coeff, cell3QCoeff]; split_ifs <;> first | exact cell3QRow_natDegree i | simp
theorem cell3SignedCurvature_innerDegree : cell3InnerDegreeLe 9 cell3SignedCurvature := by have hp1 := cell3InnerDegreeLe_derivative cell3PFull_innerDegree; have hp2 := cell3InnerDegreeLe_derivative hp1; have hq1 := cell3InnerDegreeLe_derivative cell3QFull_innerDegree; have hq2 := cell3InnerDegreeLe_derivative hq1; have hc (a : Rat) : cell3InnerDegreeLe 0 (cell3Constant a) := (by intro i; cases i <;> simp [cell3Constant]); have h1 : cell3InnerDegreeLe 9 (cell3PFull.derivative.derivative * cell3QFull ^ 2) := (by simpa [pow_two] using cell3InnerDegreeLe_mul hp2 (cell3InnerDegreeLe_mul cell3QFull_innerDegree cell3QFull_innerDegree)); have h2 : cell3InnerDegreeLe 9 (cell3Constant 2 * cell3PFull.derivative * cell3QFull * cell3QFull.derivative) := (by simpa using cell3InnerDegreeLe_mul (cell3InnerDegreeLe_mul (cell3InnerDegreeLe_mul (hc 2) hp1) cell3QFull_innerDegree) hq1); have h3 : cell3InnerDegreeLe 9 (cell3Constant 2 * cell3PFull * cell3QFull.derivative ^ 2) := (by simpa [pow_two] using cell3InnerDegreeLe_mul (cell3InnerDegreeLe_mul (hc 2) cell3PFull_innerDegree) (cell3InnerDegreeLe_mul hq1 hq1)); have h4 : cell3InnerDegreeLe 9 (cell3PFull * cell3QFull * cell3QFull.derivative.derivative) := (by simpa using cell3InnerDegreeLe_mul (cell3InnerDegreeLe_mul cell3PFull_innerDegree cell3QFull_innerDegree) hq2); have hraw := cell3InnerDegreeLe_sub (cell3InnerDegreeLe_add (cell3InnerDegreeLe_sub h1 h2) h3) h4; rw [cell3SignedCurvature, cell3RationalPolynomials]; simpa using cell3InnerDegreeLe_mul (hc (-1)) hraw

def cell0QdQdRow (i : Nat) : Polynomial Rat :=
  ∑ j ∈ Finset.range 9, C (cell0QdQdValue i j) * X ^ j

@[simp] theorem cell0QdQdRow_coeff (i l : Nat) :
    (cell0QdQdRow i).coeff l = if l < 9 then cell0QdQdValue i l else 0 := by
  simpa only [cell0QdQdRow] using
    cell0FinitePolynomial_coeff 9 l (cell0QdQdValue i)

theorem cell0QdQdRow_natDegree (i : Nat) : (cell0QdQdRow i).natDegree ≤ 8 := by
  rw [cell0QdQdRow]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro j hj
  exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j)
    (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans
    (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))


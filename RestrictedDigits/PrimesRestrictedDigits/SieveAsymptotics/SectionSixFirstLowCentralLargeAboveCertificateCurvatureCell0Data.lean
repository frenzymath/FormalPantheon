/-!
# Namespace-visible data shard for the first large-above cell
The legacy facade remains the source of the public theorem while this
namespace is assembled incrementally for the bounded signed replay.
-/
open Set
open scoped BigOperators Polynomial
namespace PrimesRestrictedDigits
noncomputable section
open Polynomial (C X)
namespace SectionSixFirstLowCentralLargeAboveCell0Certificate
abbrev BivariateRat := Polynomial (Polynomial Rat)
noncomputable def cell0Constant (a : Rat) : BivariateRat := Polynomial.C (Polynomial.C a)
noncomputable def cell0RatX : BivariateRat := Polynomial.X
noncomputable def cell0RatY : BivariateRat := Polynomial.C Polynomial.X
noncomputable def cell0RatU : BivariateRat := cell0Constant (43 / 200) + cell0Constant (470003 / 1500000 - 43 / 200) * cell0RatX
noncomputable def cell0RatE : BivariateRat := cell0RatU + cell0Constant (180001 / 500000 - 37501 / 250000)
noncomputable def cell0RatM : BivariateRat := cell0Constant (212499 / 500000) + (cell0RatE - cell0Constant (212499 / 500000)) * cell0RatY
noncomputable def cell0RatN : BivariateRat :=
  cell0Constant 2 * (cell0Constant (287501 / 500000) - cell0RatU) * cell0RatM
noncomputable def cell0RatD : BivariateRat :=
  cell0RatE * cell0Constant (212499 / 500000)
noncomputable def cell0RatPh : BivariateRat :=
  cell0Constant (-2 / 3) * cell0RatD ^ 3 -
    cell0Constant 6 * cell0RatN * cell0RatD ^ 2 +
    cell0Constant 6 * cell0RatN ^ 2 * cell0RatD +
    cell0Constant (2 / 3) * cell0RatN ^ 3
noncomputable def cell0RatA : BivariateRat :=
  (cell0RatU - cell0Constant (287501 / 500000)) * cell0RatD +
    cell0Constant (212499 / 500000) * cell0RatN
noncomputable def cell0RationalPolynomials :
    BivariateRat × BivariateRat :=
  (cell0Constant (470003 / 1500000 - 43 / 200) *
      (cell0RatE - cell0Constant (212499 / 500000)) * cell0RatPh,
    cell0Constant 4 * cell0RatU * cell0RatM * (cell0RatN + cell0RatD) ^ 2 *
      cell0RatA)
noncomputable def cell0RatPFactor : BivariateRat := cell0Constant (470003 / 1500000 - 43 / 200) * (cell0RatE - cell0Constant (212499 / 500000))
noncomputable def cell0RatB2 : BivariateRat := (cell0RatN + cell0RatD) ^ 2
noncomputable def cell0RatQUM : BivariateRat := cell0Constant 4 * cell0RatU * cell0RatM
noncomputable def cell0RatQPre : BivariateRat := cell0RatQUM * cell0RatB2
noncomputable def cell0SignedCurvature : BivariateRat :=
  let p := cell0RationalPolynomials.1
  let q := cell0RationalPolynomials.2
  cell0Constant (-1) * (p.derivative.derivative * q ^ 2 -
      cell0Constant 2 * p.derivative * q * q.derivative +
      cell0Constant 2 * p * q.derivative ^ 2 -
      p * q * q.derivative.derivative)
theorem cell0RationalPolynomials_natDegree_all : cell0RationalPolynomials.1.natDegree ≤ 7 ∧ cell0RationalPolynomials.2.natDegree ≤ 8 ∧ cell0RatN.natDegree ≤ 2 ∧ cell0RatPh.natDegree ≤ 6 ∧ cell0RatA.natDegree ≤ 2 ∧ cell0RatPFactor.natDegree ≤ 1 ∧ cell0RatB2.natDegree ≤ 4 ∧ cell0RatQUM.natDegree ≤ 2 ∧ cell0RatQPre.natDegree ≤ 6 := by
  have hc (a : Rat) : (cell0Constant a).natDegree ≤ 0 := by simp [cell0Constant]
  have hx : cell0RatX.natDegree ≤ 1 := by simp [cell0RatX]
  have hy : cell0RatY.natDegree ≤ 0 := by simp [cell0RatY]
  have hadd {p q : BivariateRat} {m n : Nat} (hp : p.natDegree ≤ m) (hq : q.natDegree ≤ n) : (p + q).natDegree ≤ max m n := Polynomial.natDegree_add_le_of_le hp hq
  have hsub {p q : BivariateRat} {m n : Nat} (hp : p.natDegree ≤ m) (hq : q.natDegree ≤ n) : (p - q).natDegree ≤ max m n := Polynomial.natDegree_sub_le_of_le hp hq
  have hmul {p q : BivariateRat} {m n : Nat} (hp : p.natDegree ≤ m) (hq : q.natDegree ≤ n) : (p * q).natDegree ≤ m + n := Polynomial.natDegree_mul_le_of_le hp hq
  have hpow {p : BivariateRat} {n : Nat} (k : Nat) (hp : p.natDegree ≤ n) : (p ^ k).natDegree ≤ k * n := Polynomial.natDegree_pow_le_of_le k hp
  have hu : cell0RatU.natDegree ≤ 1 := by rw [cell0RatU]; exact hadd (hc (43 / 200 : Rat)) (by simpa using hmul (hc (470003 / 1500000 - 43 / 200 : Rat)) hx)
  have he : cell0RatE.natDegree ≤ 1 := by rw [cell0RatE]; exact hadd hu (hc (180001 / 500000 - 37501 / 250000 : Rat))
  have hem : (cell0RatE - cell0Constant (212499 / 500000)).natDegree ≤ 1 := hsub he (hc (212499 / 500000 : Rat))
  have hm : cell0RatM.natDegree ≤ 1 := by rw [cell0RatM]; exact hadd (hc (212499 / 500000 : Rat)) (by simpa using hmul hem hy)
  have hgu : (cell0Constant (287501 / 500000) - cell0RatU).natDegree ≤ 1 := hsub (hc (287501 / 500000 : Rat)) hu
  have hn : cell0RatN.natDegree ≤ 2 := by rw [cell0RatN]; simpa using hmul (hmul (hc (2 : Rat)) hgu) hm
  have hd : cell0RatD.natDegree ≤ 1 := by rw [cell0RatD]; simpa using hmul he (hc (212499 / 500000 : Rat))
  have hnd : (cell0RatN + cell0RatD).natDegree ≤ 2 := (hadd hn hd).trans (by norm_num)
  have hpf : cell0RatPFactor.natDegree ≤ 1 := by rw [cell0RatPFactor]; simpa using hmul (hc (470003 / 1500000 - 43 / 200 : Rat)) hem
  have hb2 : cell0RatB2.natDegree ≤ 4 := by rw [cell0RatB2]; simpa using hpow 2 hnd
  have hqum : cell0RatQUM.natDegree ≤ 2 := by rw [cell0RatQUM]; simpa using hmul (hmul (hc (4 : Rat)) hu) hm
  have hqpre : cell0RatQPre.natDegree ≤ 6 := by rw [cell0RatQPre]; simpa using hmul hqum hb2
  have hph : cell0RatPh.natDegree ≤ 6 := by rw [cell0RatPh]; have h1 := (hmul (hc (-2 / 3 : Rat)) (hpow 3 hd)).trans (by norm_num : 0 + 3 ≤ 6); have h2 := (hmul (hmul (hc (6 : Rat)) hn) (hpow 2 hd)).trans (by norm_num : 0 + 2 + 2 ≤ 6); have h3 := (hmul (hmul (hc (6 : Rat)) (hpow 2 hn)) hd).trans (by norm_num : 0 + 4 + 1 ≤ 6); have h4 := (hmul (hc (2 / 3 : Rat)) (hpow 3 hn)).trans (by norm_num : 0 + 6 ≤ 6); exact hadd (hadd (hsub h1 h2) h3) h4
  have ha : cell0RatA.natDegree ≤ 2 := by rw [cell0RatA]; exact hadd (by simpa using hmul (hsub hu (hc (287501 / 500000 : Rat))) hd) (by simpa using hmul (hc (212499 / 500000 : Rat)) hn)
  refine ⟨?_, ?_, hn, hph, ha, hpf, hb2, hqum, hqpre⟩
  · rw [cell0RationalPolynomials]; simpa using hmul (hmul (hc (470003 / 1500000 - 43 / 200 : Rat)) hem) hph
  · rw [cell0RationalPolynomials]; simpa using hmul (hmul (hmul (hmul (hc (4 : Rat)) hu) hm) (hpow 2 (hadd hn hd))) ha
theorem cell0RationalPolynomials_natDegree : cell0RationalPolynomials.1.natDegree ≤ 7 ∧ cell0RationalPolynomials.2.natDegree ≤ 8 := ⟨cell0RationalPolynomials_natDegree_all.1, cell0RationalPolynomials_natDegree_all.2.1⟩
theorem cell0Stage_natDegree : cell0RatN.natDegree ≤ 2 ∧ cell0RatPh.natDegree ≤ 6 ∧ cell0RatA.natDegree ≤ 2 ∧ cell0RatPFactor.natDegree ≤ 1 ∧ cell0RatB2.natDegree ≤ 4 ∧ cell0RatQUM.natDegree ≤ 2 ∧ cell0RatQPre.natDegree ≤ 6 := cell0RationalPolynomials_natDegree_all.2.2
theorem cell0SignedCurvature_natDegree : cell0SignedCurvature.natDegree ≤ 21 := by
  let p := cell0RationalPolynomials.1; let q := cell0RationalPolynomials.2; have hc (a : Rat) : (cell0Constant a).natDegree ≤ 0 := (by simp [cell0Constant]); have hp : p.natDegree ≤ 7 := cell0RationalPolynomials_natDegree.1; have hq : q.natDegree ≤ 8 := cell0RationalPolynomials_natDegree.2
  have hp1 := (Polynomial.natDegree_derivative_le p).trans (by simpa using Nat.sub_le_sub_right hp 1); have hp2 := (Polynomial.natDegree_derivative_le p.derivative).trans (by simpa using Nat.sub_le_sub_right hp1 1); have hq1 := (Polynomial.natDegree_derivative_le q).trans (by simpa using Nat.sub_le_sub_right hq 1); have hq2 := (Polynomial.natDegree_derivative_le q.derivative).trans (by simpa using Nat.sub_le_sub_right hq1 1)
  have h1 := (Polynomial.natDegree_mul_le_of_le hp2 (Polynomial.natDegree_pow_le_of_le 2 hq)).trans (by norm_num : 5 + 16 ≤ 21); have h2 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc (2 : Rat)) hp1) hq) hq1).trans (by norm_num : 0 + 6 + 8 + 7 ≤ 21); have h3 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc (2 : Rat)) hp) (Polynomial.natDegree_pow_le_of_le 2 hq1)).trans (by norm_num : 0 + 7 + 14 ≤ 21); have h4 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le hp hq) hq2).trans (by norm_num : 7 + 8 + 6 ≤ 21)
  have h12 := Polynomial.natDegree_sub_le_of_le (m := 21) (n := 21) h1 h2; have h123 := Polynomial.natDegree_add_le_of_degree_le h12 h3; have hi := Polynomial.natDegree_sub_le_of_le (m := 21) (n := 21) h123 h4
  change (cell0Constant (-1) * (p.derivative.derivative * q ^ 2 - cell0Constant 2 * p.derivative * q * q.derivative + cell0Constant 2 * p * q.derivative ^ 2 - p * q * q.derivative.derivative)).natDegree ≤ 21
  exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := 21) (hc (-1 : Rat)) hi).trans (by norm_num)

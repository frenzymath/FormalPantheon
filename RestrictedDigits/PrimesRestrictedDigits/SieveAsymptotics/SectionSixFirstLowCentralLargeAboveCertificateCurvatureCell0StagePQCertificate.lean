def cell0PQRow (i : Nat) : Polynomial Rat :=
  ∑ j ∈ Finset.range 8, C (cell0PQValue i j) * X ^ j

@[simp] theorem cell0PQRow_coeff (i l : Nat) :
    (cell0PQRow i).coeff l = if l < 8 then cell0PQValue i l else 0 := by
  simpa only [cell0PQRow] using cell0FinitePolynomial_coeff 8 l (cell0PQValue i)

theorem cell0PQRow_natDegree (i : Nat) : (cell0PQRow i).natDegree ≤ 7 := by
  rw [cell0PQRow]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro j hj
  exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j)
    (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans
    (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))

theorem cell0StagePQ_natDegree (k : Nat) :
    (cell0StageProductRow 3 k).natDegree ≤ 7 := by
  simpa [cell0StageProductRow] using
    cell0OuterConv_natDegree cell0PCoeff cell0QCoeff 3 4
      cell0PCoeff_natDegree cell0QCoeff_natDegree k

attribute [local simp] cell0PCoeff_coeff cell0QCoeff_coeff

local macro "cell0_pq_coeff" : tactic => `(tactic|
  (rw [cell0StageProductRow, cell0OuterConv_coeff, cell0ScalarConv]
   simp_rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
   repeat rw [Finset.sum_range_succ]
   all_goals simp
   all_goals norm_num [Finset.sum_range_succ, cell0PScale, cell0QScale,
     cell0PNumerator, cell0QNumerator, cell0PQValue]
   all_goals (repeat rw [Finset.sum_range_succ])
   all_goals norm_num [Finset.sum_range_succ]
   all_goals ring_nf))


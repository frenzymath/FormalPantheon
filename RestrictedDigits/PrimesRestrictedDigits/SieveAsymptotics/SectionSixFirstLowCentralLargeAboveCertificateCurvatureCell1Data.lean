def cell1PowerCoeff (i j : Nat) : Rat :=
  cell1PowerScale * (cell1PowerNumerator i j : Rat)
def cell1PowerRow (i : Nat) : Polynomial Rat :=
  ∑ j ∈ Finset.range 11, C (cell1PowerCoeff i j) * X ^ j
noncomputable def cell1Power : BivariateRat :=
  ∑ i ∈ Finset.range 13, C (cell1PowerRow i) * X ^ i
theorem cell1FinitePolynomial_coeff {R : Type*} [Semiring R] (n l : Nat) (a : Nat → R) : (∑ j ∈ Finset.range n, Polynomial.C (a j) * Polynomial.X ^ j).coeff l = if l < n then a l else 0 := by
  rw [Polynomial.finsetSum_coeff]; simp_rw [Polynomial.coeff_C_mul_X_pow]; by_cases hl : l < n
  · rw [if_pos hl, Finset.sum_eq_single l]
    · simp
    · intro b hb hbl; simp [Ne.symm hbl]
    · exact fun hnot => (hnot (Finset.mem_range.mpr hl)).elim
  · rw [if_neg hl]; apply Finset.sum_eq_zero; intro b hb; have hlb : l ≠ b := (by rintro rfl; exact hl (Finset.mem_range.mp hb)); simp [hlb]
theorem cell1Power_outer_coeff (k : Nat) (hk : k < 13) : cell1Power.coeff k = cell1PowerRow k := by simpa only [cell1Power, if_pos hk] using cell1FinitePolynomial_coeff 13 k cell1PowerRow
theorem cell1Power_row_coeff (i l : Nat) : (cell1PowerRow i).coeff l = if l < 11 then cell1PowerCoeff i l else 0 := by simpa only [cell1PowerRow] using cell1FinitePolynomial_coeff 11 l (cell1PowerCoeff i)
theorem cell1PowerRow_natDegree (i : Nat) : (cell1PowerRow i).natDegree ≤ 10 := by rw [cell1PowerRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))
theorem cell1PFull_natDegree : cell1PFull.natDegree ≤ 4 := by rw [cell1PFull]; apply Polynomial.natDegree_sum_le_of_forall_le; intro i hi; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := i) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le i)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)))
theorem cell1QFull_natDegree : cell1QFull.natDegree ≤ 5 := by rw [cell1QFull]; apply Polynomial.natDegree_sum_le_of_forall_le; intro i hi; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := i) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le i)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)))
theorem cell1SignedCurvature_natDegree : cell1SignedCurvature.natDegree ≤ 12 := by
  let p := cell1RationalPolynomials.1; let q := cell1RationalPolynomials.2; have hc (a : Rat) : (cell1Constant a).natDegree ≤ 0 := (by simp [cell1Constant]); have hp : p.natDegree ≤ 4 := (by simpa [p, cell1RationalPolynomials] using cell1PFull_natDegree); have hq : q.natDegree ≤ 5 := (by simpa [q, cell1RationalPolynomials] using cell1QFull_natDegree); have hp1 : p.derivative.natDegree ≤ 3 := (Polynomial.natDegree_derivative_le p).trans (by simpa using Nat.sub_le_sub_right hp 1); have hp2 : p.derivative.derivative.natDegree ≤ 2 := (Polynomial.natDegree_derivative_le p.derivative).trans (by simpa using Nat.sub_le_sub_right hp1 1); have hq1 : q.derivative.natDegree ≤ 4 := (Polynomial.natDegree_derivative_le q).trans (by simpa using Nat.sub_le_sub_right hq 1); have hq2 : q.derivative.derivative.natDegree ≤ 3 := (Polynomial.natDegree_derivative_le q.derivative).trans (by simpa using Nat.sub_le_sub_right hq1 1); have h1 : (p.derivative.derivative * q ^ 2).natDegree ≤ 12 := (Polynomial.natDegree_mul_le_of_le hp2 (Polynomial.natDegree_pow_le_of_le 2 hq)).trans (by norm_num); have h2 : (cell1Constant 2 * p.derivative * q * q.derivative).natDegree ≤ 12 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc 2) hp1) hq) hq1).trans (by norm_num); have h3 : (cell1Constant 2 * p * q.derivative ^ 2).natDegree ≤ 12 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le (hc 2) hp) (Polynomial.natDegree_pow_le_of_le 2 hq1)).trans (by norm_num); have h4 : (p * q * q.derivative.derivative).natDegree ≤ 12 := (Polynomial.natDegree_mul_le_of_le (Polynomial.natDegree_mul_le_of_le hp hq) hq2).trans (by norm_num); have h12 := Polynomial.natDegree_sub_le_of_le (m := 12) (n := 12) h1 h2; have h123 := Polynomial.natDegree_add_le_of_degree_le h12 h3; change (p.derivative.derivative * q ^ 2 - cell1Constant 2 * p.derivative * q * q.derivative + cell1Constant 2 * p * q.derivative ^ 2 - p * q * q.derivative.derivative).natDegree ≤ 12; exact Polynomial.natDegree_sub_le_of_le (m := 12) (n := 12) h123 h4
def cell1PCoeff (i : Nat) : Polynomial Rat := if i < 5 then cell1PRow i else 0
def cell1QCoeff (i : Nat) : Polynomial Rat := if i < 6 then cell1QRow i else 0
theorem cell1PRow_coeff (i l : Nat) : (cell1PRow i).coeff l = if l < 4 then cell1PScale * (cell1PNumerator i l : Rat) else 0 := by simpa only [cell1PRow] using cell1FinitePolynomial_coeff 4 l (fun j => cell1PScale * (cell1PNumerator i j : Rat))
theorem cell1QRow_coeff (i l : Nat) : (cell1QRow i).coeff l = if l < 5 then cell1QScale * (cell1QNumerator i l : Rat) else 0 := by simpa only [cell1QRow] using cell1FinitePolynomial_coeff 5 l (fun j => cell1QScale * (cell1QNumerator i j : Rat))
theorem cell1PFull_coeff (i : Nat) : cell1PFull.coeff i = cell1PCoeff i := by simpa only [cell1PFull, cell1PCoeff] using cell1FinitePolynomial_coeff 5 i cell1PRow
theorem cell1QFull_coeff (i : Nat) : cell1QFull.coeff i = cell1QCoeff i := by simpa only [cell1QFull, cell1QCoeff] using cell1FinitePolynomial_coeff 6 i cell1QRow
def cell1OuterConst (a : Rat) (i : Nat) : Polynomial Rat := if i = 0 then C a else 0
def cell1OuterConv (p q : Nat → Polynomial Rat) (k : Nat) : Polynomial Rat := ∑ a ∈ Finset.antidiagonal k, p a.1 * q a.2
theorem cell1_coeff_mul_outer (p q : BivariateRat) (k : Nat) : (p * q).coeff k = cell1OuterConv (fun i => p.coeff i) (fun i => q.coeff i) k := by simp only [cell1OuterConv, Polynomial.coeff_mul]
theorem cell1PCoeff_coeff (i l : Nat) : (cell1PCoeff i).coeff l = if i < 5 then (if l < 4 then cell1PScale * (cell1PNumerator i l : Rat) else 0) else 0 := by by_cases hi : i < 5 <;> simp [cell1PCoeff, hi, cell1PRow_coeff]
theorem cell1QCoeff_coeff (i l : Nat) : (cell1QCoeff i).coeff l = if i < 6 then (if l < 5 then cell1QScale * (cell1QNumerator i l : Rat) else 0) else 0 := by by_cases hi : i < 6 <;> simp [cell1QCoeff, hi, cell1QRow_coeff]
theorem cell1OuterConst_coeff (a : Rat) (i l : Nat) : (cell1OuterConst a i).coeff l = if i = 0 then (if l = 0 then a else 0) else 0 := by by_cases hi : i = 0 <;> by_cases hl : l = 0 <;> simp [cell1OuterConst, Polynomial.coeff_C, hi, hl]
def cell1ScalarConv (p q : Nat → Nat → Rat) (k l : Nat) : Rat := ∑ a ∈ Finset.antidiagonal k, ∑ b ∈ Finset.antidiagonal l, p a.1 b.1 * q a.2 b.2
theorem cell1OuterConv_coeff (p q : Nat → Polynomial Rat) (k l : Nat) : (cell1OuterConv p q k).coeff l = cell1ScalarConv (fun i j => (p i).coeff j) (fun i j => (q i).coeff j) k l := by rw [cell1OuterConv, cell1ScalarConv, Polynomial.finsetSum_coeff]; simp_rw [Polynomial.coeff_mul]
def cell1PDerivCoeff (i : Nat) : Polynomial Rat := cell1PCoeff (i + 1) * (i + 1 : Nat)
def cell1QDerivCoeff (i : Nat) : Polynomial Rat := cell1QCoeff (i + 1) * (i + 1 : Nat)
def cell1PDeriv2Coeff (i : Nat) : Polynomial Rat := cell1PDerivCoeff (i + 1) * (i + 1 : Nat)
def cell1QDeriv2Coeff (i : Nat) : Polynomial Rat := cell1QDerivCoeff (i + 1) * (i + 1 : Nat)
theorem cell1Constant_outer_coeff (a : Rat) (i : Nat) : (cell1Constant a).coeff i = cell1OuterConst a i := by by_cases hi : i = 0 <;> simp [cell1Constant, cell1OuterConst, hi, Polynomial.coeff_C_of_ne_zero]
theorem cell1PFull_deriv_coeff (i : Nat) : cell1PFull.derivative.coeff i = cell1PDerivCoeff i := by simp [cell1PDerivCoeff, Polynomial.coeff_derivative, cell1PFull_coeff]
theorem cell1QFull_deriv_coeff (i : Nat) : cell1QFull.derivative.coeff i = cell1QDerivCoeff i := by simp [cell1QDerivCoeff, Polynomial.coeff_derivative, cell1QFull_coeff]
theorem cell1PFull_deriv2_coeff (i : Nat) : cell1PFull.derivative.derivative.coeff i = cell1PDeriv2Coeff i := by simp only [Polynomial.coeff_derivative, cell1PDeriv2Coeff, cell1PDerivCoeff, cell1PFull_coeff]; push_cast; ring
theorem cell1QFull_deriv2_coeff (i : Nat) : cell1QFull.derivative.derivative.coeff i = cell1QDeriv2Coeff i := by simp only [Polynomial.coeff_derivative, cell1QDeriv2Coeff, cell1QDerivCoeff, cell1QFull_coeff]; push_cast; ring
theorem cell1PDerivCoeff_coeff (i l : Nat) : (cell1PDerivCoeff i).coeff l = (cell1PCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell1PDerivCoeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
theorem cell1QDerivCoeff_coeff (i l : Nat) : (cell1QDerivCoeff i).coeff l = (cell1QCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell1QDerivCoeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
theorem cell1PDeriv2Coeff_coeff (i l : Nat) : (cell1PDeriv2Coeff i).coeff l = (cell1PDerivCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell1PDeriv2Coeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
theorem cell1QDeriv2Coeff_coeff (i l : Nat) : (cell1QDeriv2Coeff i).coeff l = (cell1QDerivCoeff (i + 1)).coeff l * (i + 1 : Nat) := by rw [cell1QDeriv2Coeff, ← Polynomial.C_eq_natCast, Polynomial.coeff_mul_C]
def cell1TwoPdCoeff (i : Nat) : Polynomial Rat := C 2 * cell1PDerivCoeff i
def cell1TwoPCoeff (i : Nat) : Polynomial Rat := C 2 * cell1PCoeff i
theorem cell1TwoPdCoeff_coeff (i l : Nat) : (cell1TwoPdCoeff i).coeff l = 2 * (cell1PDerivCoeff i).coeff l := by simp [cell1TwoPdCoeff, Polynomial.coeff_C_mul]
theorem cell1TwoPCoeff_coeff (i l : Nat) : (cell1TwoPCoeff i).coeff l = 2 * (cell1PCoeff i).coeff l := by simp [cell1TwoPCoeff, Polynomial.coeff_C_mul]
def cell1SignedOuterRaw (k : Nat) : Polynomial Rat := cell1OuterConv cell1PDeriv2Coeff (fun j => cell1OuterConv cell1QCoeff cell1QCoeff j) k - cell1OuterConv (fun j => cell1OuterConv (fun h => cell1OuterConv (cell1OuterConst 2) cell1PDerivCoeff h) cell1QCoeff j) cell1QDerivCoeff k + cell1OuterConv (fun j => cell1OuterConv (cell1OuterConst 2) cell1PCoeff j) (fun j => cell1OuterConv cell1QDerivCoeff cell1QDerivCoeff j) k - cell1OuterConv (fun j => cell1OuterConv cell1PCoeff cell1QCoeff j) cell1QDeriv2Coeff k
theorem cell1SignedCurvature_coeff_raw (k : Nat) : cell1SignedCurvature.coeff k = cell1SignedOuterRaw k := by rw [cell1SignedCurvature, cell1RationalPolynomials]; simp only [cell1SignedOuterRaw, Polynomial.coeff_sub, Polynomial.coeff_add, cell1_coeff_mul_outer, pow_two, cell1PFull_coeff, cell1QFull_coeff, cell1PFull_deriv_coeff, cell1QFull_deriv_coeff, cell1PFull_deriv2_coeff, cell1QFull_deriv2_coeff, cell1Constant_outer_coeff]
theorem cell1TwoPd_outer_eq (i : Nat) : cell1OuterConv (cell1OuterConst 2) cell1PDerivCoeff i = cell1TwoPdCoeff i := by have h := cell1_coeff_mul_outer (cell1Constant 2) cell1PFull.derivative i; simp_rw [cell1Constant_outer_coeff, cell1PFull_deriv_coeff] at h; rw [cell1Constant, Polynomial.coeff_C_mul, cell1PFull_deriv_coeff] at h; simpa only [cell1TwoPdCoeff] using h.symm
theorem cell1TwoP_outer_eq (i : Nat) : cell1OuterConv (cell1OuterConst 2) cell1PCoeff i = cell1TwoPCoeff i := by have h := cell1_coeff_mul_outer (cell1Constant 2) cell1PFull i; simp_rw [cell1Constant_outer_coeff, cell1PFull_coeff] at h; rw [cell1Constant, Polynomial.coeff_C_mul, cell1PFull_coeff] at h; simpa only [cell1TwoPCoeff] using h.symm
def cell1StageProductRow (s k : Nat) : Polynomial Rat := match s with | 0 => cell1OuterConv cell1QCoeff cell1QCoeff k | 1 => cell1OuterConv cell1TwoPdCoeff cell1QCoeff k | 2 => cell1OuterConv cell1QDerivCoeff cell1QDerivCoeff k | 3 => cell1OuterConv cell1PCoeff cell1QCoeff k | _ => 0
def cell1SignedOuterRow (k : Nat) : Polynomial Rat := cell1OuterConv cell1PDeriv2Coeff (cell1StageProductRow 0) k - cell1OuterConv (cell1StageProductRow 1) cell1QDerivCoeff k + cell1OuterConv cell1TwoPCoeff (cell1StageProductRow 2) k - cell1OuterConv (cell1StageProductRow 3) cell1QDeriv2Coeff k
theorem cell1SignedOuterRaw_eq (k : Nat) : cell1SignedOuterRaw k = cell1SignedOuterRow k := by have hpd : (fun i : Nat => cell1OuterConv (cell1OuterConst 2) cell1PDerivCoeff i) = cell1TwoPdCoeff := funext cell1TwoPd_outer_eq; have hp : (fun i : Nat => cell1OuterConv (cell1OuterConst 2) cell1PCoeff i) = cell1TwoPCoeff := funext cell1TwoP_outer_eq; have h0 : cell1StageProductRow 0 = (fun j : Nat => cell1OuterConv cell1QCoeff cell1QCoeff j) := (by funext j; rfl); have h1 : cell1StageProductRow 1 = (fun j : Nat => cell1OuterConv cell1TwoPdCoeff cell1QCoeff j) := (by funext j; rfl); have h2 : cell1StageProductRow 2 = (fun j : Nat => cell1OuterConv cell1QDerivCoeff cell1QDerivCoeff j) := (by funext j; rfl); have h3 : cell1StageProductRow 3 = (fun j : Nat => cell1OuterConv cell1PCoeff cell1QCoeff j) := (by funext j; rfl); unfold cell1SignedOuterRaw cell1SignedOuterRow; rw [hpd, hp, h0, h1, h2, h3]
theorem cell1SignedCurvature_coeff_formula (k : Nat) : cell1SignedCurvature.coeff k = cell1SignedOuterRow k := (cell1SignedCurvature_coeff_raw k).trans (cell1SignedOuterRaw_eq k)
def cell1InnerDegreeLe (n : Nat) (p : BivariateRat) : Prop := ∀ i, (p.coeff i).natDegree ≤ n
theorem cell1InnerDegreeLe_add {n : Nat} {p q : BivariateRat} (hp : cell1InnerDegreeLe n p) (hq : cell1InnerDegreeLe n q) : cell1InnerDegreeLe n (p + q) := by intro i; rw [Polynomial.coeff_add]; exact Polynomial.natDegree_add_le_of_degree_le (hp i) (hq i)
theorem cell1InnerDegreeLe_sub {n : Nat} {p q : BivariateRat} (hp : cell1InnerDegreeLe n p) (hq : cell1InnerDegreeLe n q) : cell1InnerDegreeLe n (p - q) := by intro i; rw [Polynomial.coeff_sub]; simpa using Polynomial.natDegree_sub_le_of_le (m := n) (n := n) (hp i) (hq i)
theorem cell1InnerDegreeLe_mul {m n : Nat} {p q : BivariateRat} (hp : cell1InnerDegreeLe m p) (hq : cell1InnerDegreeLe n q) : cell1InnerDegreeLe (m + n) (p * q) := by intro i; rw [Polynomial.coeff_mul]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact Polynomial.natDegree_mul_le_of_le (hp j.1) (hq j.2)
theorem cell1InnerDegreeLe_derivative {n : Nat} {p : BivariateRat} (hp : cell1InnerDegreeLe n p) : cell1InnerDegreeLe n p.derivative := by intro i; rw [Polynomial.coeff_derivative]; have hs : (C ((i + 1 : Nat) : Rat)).natDegree ≤ 0 := (Polynomial.natDegree_C _).le; simpa using Polynomial.natDegree_mul_le_of_le (hp (i + 1)) hs
theorem cell1PRow_natDegree (i : Nat) : (cell1PRow i).natDegree ≤ 3 := by rw [cell1PRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))
theorem cell1QRow_natDegree (i : Nat) : (cell1QRow i).natDegree ≤ 4 := by rw [cell1QRow]; apply Polynomial.natDegree_sum_le_of_forall_le; intro j hj; exact (Polynomial.natDegree_mul_le_of_le (m := 0) (n := j) (Polynomial.natDegree_C _).le (Polynomial.natDegree_X_pow_le j)).trans (by simpa using (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)))
theorem cell1PFull_innerDegree : cell1InnerDegreeLe 3 cell1PFull := by intro i; rw [cell1PFull_coeff, cell1PCoeff]; split_ifs <;> first | exact cell1PRow_natDegree i | simp

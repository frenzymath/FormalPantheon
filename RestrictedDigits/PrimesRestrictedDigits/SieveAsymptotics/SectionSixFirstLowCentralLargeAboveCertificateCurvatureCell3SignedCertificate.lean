theorem cell3Signed_eq_power : cell3SignedCurvature = cell3Power := by
  ext k l
  by_cases hk : k < 25
  · rw [cell3Power_outer_coeff k hk]
    interval_cases k <;> simp
  · have hk' : 25 ≤ k := Nat.le_of_not_gt hk
    have hs : cell3SignedCurvature.coeff k = 0 :=
      Polynomial.coeff_eq_zero_of_natDegree_lt
        (cell3SignedCurvature_natDegree.trans_lt (Nat.lt_of_succ_le hk'))
    have hp : cell3Power.coeff k = 0 := by
      rw [cell3Power, Polynomial.finsetSum_coeff]
      simp [hk']
    rw [hs, hp]


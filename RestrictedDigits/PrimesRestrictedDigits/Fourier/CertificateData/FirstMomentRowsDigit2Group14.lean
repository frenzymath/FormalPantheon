import PrimesRestrictedDigits.Fourier.CertificateData.FirstMomentRowsDigit2Group13Result

/-! Bounds for 200 lower-half digit-2 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem firstMomentRowsDigit2Group14Block00 :
    forall offset : Fin 10,
      firstMomentIndexedRow (2 : Fin 5)
        ⟨2800 + offset.val, by omega⟩ := by
  simp only [firstMomentIndexedRow_def]
  decide +kernel


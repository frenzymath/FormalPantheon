import PrimesRestrictedDigits.Fourier.CertificateData.FirstMomentRowsDigit4Group10Result

/-! Bounds for 200 lower-half digit-4 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem firstMomentRowsDigit4Group11Block00 :
    forall offset : Fin 10,
      firstMomentIndexedRow (4 : Fin 5)
        ⟨2200 + offset.val, by omega⟩ := by
  simp only [firstMomentIndexedRow_def]
  decide +kernel


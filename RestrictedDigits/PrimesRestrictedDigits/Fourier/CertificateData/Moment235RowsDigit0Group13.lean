import PrimesRestrictedDigits.Fourier.Moment235CertificateRows

/-! Bounds for 200 lower-half digit-0 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem moment235RowsDigit0Group13Block00 :
    forall offset : Fin 10,
      moment235IndexedRow (0 : Fin 5)
        ⟨2600 + offset.val, by omega⟩ := by
  simp only [moment235IndexedRow_def]
  decide +kernel


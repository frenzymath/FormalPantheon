import PrimesRestrictedDigits.Fourier.CertificateData.FirstMomentRowsDigit0Group09Result

/-! Bounds for 200 lower-half digit-0 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem firstMomentRowsDigit0Group10Block00 :
    forall offset : Fin 10,
      firstMomentIndexedRow (0 : Fin 5)
        ⟨2000 + offset.val, by omega⟩ := by
  simp only [firstMomentIndexedRow_def]
  decide +kernel


import PrimesRestrictedDigits.Fourier.CertificateData.FirstMomentRowsDigit3Group11Result

/-! Bounds for 200 lower-half digit-3 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem firstMomentRowsDigit3Group12Block00 :
    forall offset : Fin 10,
      firstMomentIndexedRow (3 : Fin 5)
        ⟨2400 + offset.val, by omega⟩ := by
  simp only [firstMomentIndexedRow_def]
  decide +kernel


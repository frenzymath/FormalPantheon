import PrimesRestrictedDigits.Fourier.CertificateData.FirstMomentRowsDigit1Group00Result

/-! Bounds for 200 lower-half digit-1 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem firstMomentRowsDigit1Group01Block00 :
    forall offset : Fin 10,
      firstMomentIndexedRow (1 : Fin 5)
        ⟨200 + offset.val, by omega⟩ := by
  simp only [firstMomentIndexedRow_def]
  decide +kernel


import PrimesRestrictedDigits.Fourier.Moment235CertificateRows

/-! Bounds for 200 lower-half digit-3 rows. -/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace PrimesRestrictedDigits

theorem moment235RowsDigit3Group00Block00 :
    forall offset : Fin 10,
      moment235IndexedRow (3 : Fin 5)
        ⟨0 + offset.val, by omega⟩ := by
  simp only [moment235IndexedRow_def]
  decide +kernel

